---
// Requirement 034: the interview and resume guide. Dev-only page injected at
// /harness/interview-guide/; content lives here, the reusable lists live in
// harness/interview-guide.mjs. No storage, no model calls, no network.
import Layout from '../../src/layouts/Layout.astro';
import Header from '../../src/components/Header.astro';
import Cite from '../components/cite.astro';
import ReturnNav from '../components/return-nav.astro';
import { withBase } from '../../src/lib/site-path.mjs';
import {
  HARNESS_PATH,
  HARNESS_SITE_PATH,
  INTERVIEW_PATH,
} from '../routes.mjs';
import {
  CHECKS,
  EVIDENCE,
  JD_LAYERS,
  LEVELS,
  PHASES,
  PITFALLS,
  PLAN,
  POSITIONING,
  READERS,
  SECTIONS,
  SOURCES,
  STAGES,
  STEPS,
} from '../harness/interview-guide.mjs';
import '../client/harness/interview-guide.css';

const archive = (path: string) => withBase(`${HARNESS_SITE_PATH}${path}`);
const interviewHref = withBase(INTERVIEW_PATH);
const harnessHref = withBase(HARNESS_PATH);
const resumeHref = archive('ai-pm-resume.html');
const questionsHref = archive('ai-pm-interview-questions.html');
const careerHref = archive('ai-agent-pm-career.html');
const examHref = archive('ai-pm-exam.html');
---

<Layout
    locale="zh-CN"
    title="产品经理面试与简历方法论 · Harness 学习"
    description="面试官怎么评分、简历怎么写证据、如何对齐企业要求：五步证据法、八个环节、JD 四层与面试前清单。"
  >
  <Header locale="zh-CN" />
  <main id="main-content" class="ig-page page-width" data-ig-root>
    <header class="ig-hero">
      <p class="ig-eyebrow">AI 产品经理 · 面试与简历</p>
      <h1>产品经理面试与简历方法论</h1>
      <p class="ig-lead">
        面试不是才艺表演。招聘方在花一笔预算买一个结果，他要判断的是：把这件事交给你，失败的概率有多低。
        简历负责提出一个可验证的假设，面试负责用证据验证它。这一页把两件事合成一条方法：
        定标、取证、对齐、演练、复盘。
      </p>
      <div class="ig-hero-actions">
        <a class="ig-button" href="#s3">从一条简历句开始</a>
        <a class="ig-link" href={interviewHref}>用模拟面试练一轮 →</a>
        <button class="ig-ghost" type="button" data-ig-print>打印这份清单</button>
      </div>
      <ol class="ig-flow" aria-label="五步证据法">
        {
          STEPS.map((step) => (
            <li>
              <a href="#s8">
                <span class="ig-flow-no">{step.no}</span>
                <strong>{step.title}</strong>
                <span class="ig-flow-ask">{step.ask}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="ig-hero-meta">
        {SECTIONS.length} 节 · {SOURCES.length} 条来源 · 每条标注类型与日期
      </p>
    </header>

    <div class="ig-layout">
      <aside class="ig-toc" aria-label="本页目录" data-ig-toc>
        <p class="ig-toc-title">目录</p>
        <ol>
          {
            SECTIONS.map((section) => (
              <li>
                <a href={`#${section.id}`} data-ig-toc-link={section.id}>
                  <span>{section.no}</span>
                  {section.title}
                </a>
              </li>
            ))
          }
        </ol>
        <p class="ig-toc-foot">
          先读方法，再去练：<a href={interviewHref}>模拟面试</a>
        </p>
      </aside>

      <div class="ig-body">
        <section class="ig-section" id="s1" data-ig-section>
          <p class="ig-kicker">01 · 规则</p>
          <h2>面试在考什么：一场降低误判风险的采购</h2>
          <p class="ig-lead">
            面试官不只是在找最强的人，而是在找最不可能失败的人。所有问题最后都落回三件事：
            你能不能做、愿不愿做、好不好合作。每一件都要证据，也都要评估风险。
          </p>

          <h3>结构化面试：同一把尺子</h3>
          <p>
            Google 把结构化面试拆成四件事：统一题库、完整记录、统一量表、面试官培训
            <Cite id="S1" />。面试官按分配到的维度独立打分并写评语，招聘人员汇总成材料包；
            委员会只看材料包，可以要求补充或加面，材料混合时仍可否决
            <Cite id="S4" />。这套做法要解决的，是“像我的人更容易过”的偏差。
          </p>
          <p>
            效度研究常被引用成一句“结构化面试比非结构化准”。数字要带口径：1998 年元分析里，
            结构化面试的校正效度约 0.51、非结构化约 0.38<Cite id="S7" />；2022 年重估后，
            结构化降到约 0.42、工作样本约 0.33、一般认知能力约 0.31<Cite id="S8" />。
            结论方向没变，绝对值要按新口径说。
          </p>

          <div class="ig-table-wrap">
            <table class="ig-table">
              <caption>评分表长什么样（示例，不是任何公司的官方表）</caption>
              <thead>
                <tr><th>维度</th><th>1–2 分</th><th>3 分</th><th>4–5 分</th><th>证据从哪来</th></tr>
              </thead>
              <tbody>
                <tr><td>问题定义</td><td>复述需求</td><td>说出用户与场景</td><td>能重定义问题，并给判断依据</td><td>追问记录</td></tr>
                <tr><td>用户与数据</td><td>只给结论</td><td>有分群与指标</td><td>能拆口径、指出数据局限</td><td>简历与答题</td></tr>
                <tr><td>取舍</td><td>只讲方案</td><td>能说两个选项</td><td>能说清放弃的代价</td><td>项目追问</td></tr>
                <tr><td>落地</td><td>讲功能</td><td>有里程碑与协作</td><td>有失败预案与验收标准</td><td>项目复盘</td></tr>
                <tr><td>协作与动机</td><td>泛泛而谈</td><td>有具体冲突处理</td><td>能说清他人视角与选择逻辑</td><td>行为面</td></tr>
              </tbody>
            </table>
          </div>
          <p class="ig-note">
            用法：把自己最近一次面试的回答按这五列打分。低于 3 分的那一格，就是下一轮要补的证据。
          </p>

          <h3>海外：维度分开，独立打分</h3>
          <ul class="ig-list">
            <li>
              <strong>Google</strong>：现场 4–5 场，每场指定 1–2 个维度，面试官先独立写完反馈再互看
              <Cite id="S1" /><Cite id="S4" />。近两年二手材料称新增 Craft and Execution 轮，
              评估扩到六个领域<Cite id="S4" />；维度名各来源不一，记住“每场一个维度、独立评分”即可。
            </li>
            <li>
              <strong>Meta</strong>：招聘人员面 + 两场电话（product sense、analytical）+ 三场现场，
              每场约 45 分钟，独立评分<Cite id="S5" /><Cite id="S6" />。分群是产品感题的命门，
              分群虚，后面的方案与指标都会塌<Cite id="S5" />。
            </li>
            <li>
              <strong>Amazon</strong>：60 分钟电话筛，一半领导力准则、一半职能；现场 5 场 × 55 分钟，
              每场 2–3 题，5 个工作日出结果；写作测评在面试前发出<Cite id="S2" />。
            </li>
            <li>
              <strong>Microsoft</strong>：官方写明结构化面试、全程虚拟流程；AI 可用于准备，
              但面试与测评中要独立作答<Cite id="S3" />。
            </li>
          </ul>

          <h3>2026 的新变化</h3>
          <ul class="ig-list">
            <li>
              <strong>AI 能力成了硬门槛</strong>：不少 AI PM 岗位的技术电话面会直接考 LLM / RAG / Agent / evals 与模型选型，
              不写代码，但要讲清边界；评测、responsible-AI 上线、Agent 产品这些 AI 专项 case 也开始出现在轮次里
              <Cite id="S29" />。
            </li>
            <li>
              <strong>现场轮替代 take-home</strong>：AI 让 take-home 容易代做，部分公司把它降级或取消，
              改成现场改一版、讲一个原型；带可点原型、eval 样本或真实小项目，比讲框架有效<Cite id="S30" />。
            </li>
            <li>
              <strong>AI 功能是分布，不是二值</strong>：每个答案都要带上失败模式、指标与成本；
              只讲「能做什么」，会被追问「错了怎么办、贵不贵、谁负责」<Cite id="S29" />。
            </li>
          </ul>

          <h3>国内：轮次多，验证的是“一致性”</h3>
          <div class="ig-table-wrap">
            <table class="ig-table">
              <caption>常见轮次（候选人自述样本，不是公司官方口径）</caption>
              <thead>
                <tr><th>轮次</th><th>谁面</th><th>在验证什么</th><th>可对照的样本</th></tr>
              </thead>
              <tbody>
                <tr><td>一面</td><td>直属主管 / 资深 PM</td><td>项目细节、能不能干活</td><td>字节校招 45 分钟，只挖一段实习<Cite id="S20" /></td></tr>
                <tr><td>二面</td><td>部门 leader</td><td>判断、取舍、潜力</td><td>字节 30 分钟压力面：冷启动三方案、估算并追问依据<Cite id="S20" /></td></tr>
                <tr><td>三面</td><td>总监 / 业务负责人</td><td>业务理解、策略、边界</td><td>字节 25 分钟<Cite id="S20" /></td></tr>
                <tr><td>交叉面</td><td>其他团队负责人</td><td>协作、一致性、有没有硬伤</td><td>阿里实习交叉面只 4 问，含“如果今天没过你会怎样”<Cite id="S21" /></td></tr>
                <tr><td>HR 面</td><td>HR / HRBP</td><td>动机、稳定性、薪资与风险</td><td>字节 15 分钟<Cite id="S20" />；阿里 HR 面 19 问，追到数据口径<Cite id="S21" /></td></tr>
                <tr><td>群面</td><td>校招 / 产培</td><td>表达、协作、结构化</td><td>腾讯产培：15 分钟读题 + 每人 3 分钟陈述 + 互问<Cite id="S22" /></td></tr>
              </tbody>
            </table>
          </div>
          <p>
            不是每家公司都走满六轮。同一年份、不同业务线，校招与社招的流程都不一样；
            看到“几轮”的说法，先问是哪一年、什么岗、什么批次。轮次越多，越是在验证
            “你讲的、简历写的、别人评价的是不是一回事”，而不是“你有多优秀”。
          </p>
          <p class="ig-callout">
            一句话：一面看你能不能干活，二面看你有没有判断，交叉面看你是否可信，HR 面看你是否稳定。
            每一轮都在为同一个问题收集证据：把这件事交给你，失败的概率有多低。
          </p>
        </section>

        <section class="ig-section" id="s2" data-ig-section>
          <p class="ig-kicker">02 · 读者</p>
          <h2>简历怎么被读：四类读者，两段筛选</h2>
          <p class="ig-lead">
            Laszlo Bock 说过，简历的唯一目的是让你过第一轮筛选、进到面试
            <Cite id="S11" />。它不是自传，是一份给四类读者看的证据摘要。
          </p>

          <div class="ig-table-wrap">
            <table class="ig-table">
              <caption>同一份简历，四种读法</caption>
              <thead>
                <tr><th>读者</th><th>在看什么</th><th>给多久</th><th>你要做的动作</th></tr>
              </thead>
              <tbody>
                {
                  READERS.map((reader) => (
                    <tr>
                      <td>{reader.role}</td>
                      <td>{reader.looks}</td>
                      <td>{reader.time}</td>
                      <td>{reader.action}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <p>
            时间说法很多，口径不同：2018 年眼动研究里，30 名招聘官初筛平均停 7.4 秒
            <Cite id="S14" />；2025 年 1,013 名 HR 的自报调查里，多数在 30 秒内决定是否细看
            <Cite id="S9" />；2023 年一项 114 名招聘官的实测，三种任务分别是 17、27、46 秒
            <Cite id="S10" />。它们都在说同一件事：初筛是几十秒量级，别指望被逐字读。
            通过初筛后还有约 11.5 分钟深读<Cite id="S9" />，所以第二页也要有证据。
          </p>

          <h3>机器先读：ATS 六查</h3>
          <ol class="ig-list ig-list-number">
            <li><strong>文件</strong>：同一份内容存 PDF 与 DOCX。76.8% 的 HR 偏好 PDF<Cite id="S9" />，
              高校就业中心建议用 Word 排版后导出<Cite id="S13" />；两份都交，成本只有一次导出。</li>
            <li><strong>版式</strong>：单栏、标准节名、不用表格嵌套与文本框；导出后检查文字能否选中。</li>
            <li><strong>标题</strong>：用「工作经历 / 项目 / 技能 / 教育」这类标准名，不用「我的旅程」。</li>
            <li><strong>时间</strong>：倒序，年月连续；空窗期用一句话说明，不留空白。</li>
            <li><strong>关键词</strong>：JD 原词自然出现在经历里；堆在技能栏不算命中。</li>
            <li><strong>文本</strong>：不用图片型 PDF、不在页眉页脚放关键信息。</li>
          </ol>
          <p class="ig-note">
            招聘系统里，HR 常按关键词搜索候选人，而不是等系统自动淘汰<Cite id="S15" />；
            所以要对齐 JD 原词，但每一句都要有项目撑着。所谓「匹配率 80%」是工具自家算法，
            不是雇主的分数<Cite id="S15" />。
          </p>

          <p>
            长度没有统一标准：Bock 的经验是每十年一页<Cite id="S12" />；2025 年的调查里，
            82.1% 的 HR 认为 1–2 页理想<Cite id="S9" />。应届与三五年经验用一页，
            资深或项目跨多个领域再用两页，第二页也要有证据。
          </p>

          <p>
            AI 可以帮你改措辞，但别让它替你写：2025 年的调查里，81.6% 的 HR 遇到过 AI 生成的求职信，
            54% 对未经修改的 AI 内容持负面态度<Cite id="S9" />。事实、口径与个人贡献必须自己写。
          </p>

          <h3>简历的四个任务</h3>
          <ol class="ig-list ig-list-number">
            <li><strong>过门槛</strong>：学历、年限、行业、地点，一眼能对上。</li>
            <li><strong>给证据</strong>：每条关键经历至少一条带口径的结果。</li>
            <li><strong>给主线</strong>：读完能复述「你是谁、你最擅长解决哪类问题」。</li>
            <li><strong>给追问入口</strong>：你写下的每一句，都准备好被追问三层。</li>
          </ol>
          <p>
            证据怎么分级、七步怎么走，见既有的
            <a href={resumeHref}>零 AI 经验简历指南</a>；本页不重复那套流程，
            只补「读者、顺序、对齐」这三件它讲得少的事。
          </p>
        </section>

        <section class="ig-section" id="s3" data-ig-section>
          <p class="ig-kicker">03 · 证据</p>
          <h2>把职责写成证据：四要素、四问、三组改写</h2>
          <p class="ig-lead">
            招聘方不怀疑你努力，只怀疑两件事：这件事是不是你做的，做到什么程度。
            一条好句子的任务，是让这两个怀疑都消失。
          </p>

          <h3>四要素</h3>
          <div class="ig-cards">
            {
              EVIDENCE.parts.map((part) => (
                <article class="ig-card">
                  <h4>{part.title}</h4>
                  <p>{part.detail}</p>
                </article>
              ))
            }
          </div>

          <h3>四个追问</h3>
          <div class="ig-qgrid">
            {
              EVIDENCE.questions.map((item) => (
                <div class="ig-q">
                  <p class="ig-q-title">{item.q}</p>
                  <p>{item.why}</p>
                </div>
              ))
            }
          </div>

          <h3>三组 Before / After</h3>
          <div class="ig-examples">
            {
              EVIDENCE.examples.map((example) => (
                <article class="ig-example">
                  <p class="ig-example-label">{example.label}</p>
                  <p class="ig-before"><span>改前</span>{example.before}</p>
                  <p class="ig-after"><span>改后</span>{example.after}</p>
                  <p class="ig-note">{example.note}</p>
                </article>
              ))
            }
          </div>

          <h3>没有数字怎么办</h3>
          <ul class="ig-list">
            {EVIDENCE.fallbacks.map((line) => <li>{line}</li>)}
          </ul>

          <h3>AI 项目多带一件东西：评测样本</h3>
          <p>
            2026 年的 AI PM 面试，比「你做过 AI」更有说服力的是「你怎么知道它做得好」<Cite id="S30" />。
            最小版本：20 条真实输入，四类失败（错、没用、不合品牌、不安全），每条标严重度，给基线与通过率。
            评测要能说清任务、跑了几次、评分逻辑是什么；只跑一次通过不算评测<Cite id="S32" />。
          </p>
          <pre class="ig-code">样本编号 | 输入 | 期望 | 实际 | 失败类型 | 严重度</pre>

          <h3 id="builder">把一条职责改成证据句</h3>
          <p>
            选一个模板，填四个空，页面会拼成一句。它只负责句式，不负责真实：
            数字、口径、归因都要你自己能答。
          </p>
          <form class="ig-builder" data-ig-builder>
            <div class="ig-builder-fields">
              <label class="ig-field">
                <span>模板</span>
                <select data-ig-template>
                  <option value="result">业务结果型</option>
                  <option value="growth">增长型</option>
                  <option value="zero">0 到 1 型</option>
                </select>
              </label>
              <label class="ig-field">
                <span>对象 / 场景</span>
                <input data-ig-scene placeholder="例如：报销审核" autocomplete="off" />
              </label>
              <label class="ig-field">
                <span>你的关键动作</span>
                <input data-ig-move placeholder="例如：拆 7 类驳回原因，先规则校验再人工复核" autocomplete="off" />
              </label>
              <label class="ig-field">
                <span>结果与口径</span>
                <input data-ig-result placeholder="例如：从 3 天压到 4 小时（财务后台 Q3 日志，月均 3,000 单）" autocomplete="off" />
              </label>
              <label class="ig-field">
                <span>可复用的方法</span>
                <input data-ig-method placeholder="例如：先定位驳回原因，再决定自动化边界" autocomplete="off" />
              </label>
            </div>
            <div class="ig-builder-out">
              <p class="ig-builder-label">生成结果</p>
              <p class="ig-builder-text" data-ig-output aria-live="polite">填完四个空，这里会出现一句话。</p>
              <div class="ig-builder-actions">
                <button class="ig-button" type="button" data-ig-copy>复制这句话</button>
                <span class="ig-builder-status" data-ig-status role="status"></span>
              </div>
            </div>
            <p class="ig-note">
              生成器只在浏览器里拼字符串，不上传、不保存。数字是演示口径，换成你自己的真实数据，
              并准备好分母与时间窗。
            </p>
          </form>
          <noscript>
            <p class="ig-note">未启用 JavaScript 时生成器不可用，可直接用上面的三组 Before / After 手写。</p>
          </noscript>
        </section>

        <section class="ig-section" id="s4" data-ig-section>
          <p class="ig-kicker">04 · 定位</p>
          <h2>突出自己：一条主线，三种策略</h2>
          <p class="ig-lead">
            突出不是形容词堆砌，而是在对方最怕出错的地方，你有别人替代不了的证据。
            先选一条主线，再用三种策略之一把它证明出来。
          </p>

          <h3>先问四个问题</h3>
          <div class="ig-cards">
            {
              POSITIONING.questions.map((item) => (
                <article class="ig-card">
                  <p class="ig-card-kicker">{item.q}</p>
                  <p>{item.detail}</p>
                </article>
              ))
            }
          </div>

          <h3>三种策略</h3>
          <div class="ig-table-wrap">
            <table class="ig-table">
              <thead>
                <tr><th>策略</th><th>适合谁</th><th>怎么写</th><th>风险</th></tr>
              </thead>
              <tbody>
                {
                  POSITIONING.strategies.map((strategy) => (
                    <tr>
                      <td><strong>{strategy.title}</strong></td>
                      <td>{strategy.fit}</td>
                      <td>{strategy.write}</td>
                      <td>{strategy.risk}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <h3>一句定位</h3>
          <p class="ig-formula">{POSITIONING.formula}</p>
          <ul class="ig-list ig-samples">
            {POSITIONING.samples.map((sample) => <li>{sample}</li>)}
          </ul>
          <p class="ig-note">
            写完让一个不了解你的人复述 30 秒。复述不出来，说明定位句还只是形容词。
          </p>

          <h3>前三分之一屏放什么</h3>
          <ol class="ig-list ig-list-number">
            <li>标题：岗位方向 + 年限，例如「AI 产品经理 · 5 年 B 端」。</li>
            <li>一句定位：用上面的公式，不超过两行。</li>
            <li>最强证据：最近或最相关的一段经历，第一条 bullet 就带结果。</li>
            <li>第二条证据：补宽度，证明你不是只会一件事。</li>
            <li>技能：只放能被项目证明的词，证书放最后。</li>
          </ol>
          <p class="ig-callout">
            全能叙事等于没有记忆点。一条主线加两条侧证，比五段平均用力更有效；
            但主线必须是真的，撑不住的“精通”会在第一轮追问里塌。
          </p>
          <p>
            边界也要说清：贴合企业要求可以改排序、改措辞、改证明方式，不能改事实。
            学历、职位、时间线、数字都会被背调核对<Cite id="S17" />；Bock 列的五类错误里，拼写、长度与不诚实最容易让一份简历被直接放弃
            <Cite id="S12" />。姓名与背景带来的偏差真实存在
            <Cite id="S16" />，但“顺应”不等于接受不合理的要求，婚育情况本来就不该被问
            <Cite id="S19" />。
          </p>
        </section>

        <section class="ig-section" id="s5" data-ig-section>
          <p class="ig-kicker">05 · 对齐</p>
          <h2>顺应企业要求：把 JD 拆成四层</h2>
          <p class="ig-lead">
            顺应不是迎合，是翻译：把企业的语言翻译成你的证据，把你的证据翻译成他能验证的形式。
            一份 JD 读四层，就知道该写什么、不该硬凑什么。
          </p>

          <div class="ig-table-wrap">
            <table class="ig-table">
              <thead>
                <tr><th>层</th><th>看什么</th><th>怎么处理</th><th>AI PM 例子</th></tr>
              </thead>
              <tbody>
                {
                  JD_LAYERS.map((layer) => (
                    <tr>
                      <td><strong>{layer.title}</strong></td>
                      <td>{layer.detail}</td>
                      <td>{layer.action}</td>
                      <td>{layer.example}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <p>
            腾讯元宝的 JD 把「深度理解模型能力边界」和「拥抱模型的不确定性、保持随模型迭代的扩展性」
            写进职责<Cite id="S26" />；这类措辞对应的不是知识题，而是你做过没有。
          </p>
          <p>
            别把关键词当成门槛的全部。700 条北京 AI 岗 JD 的统计里，大模型出现 58%、
            RAG 21%、Prompt 17%，而写明「X 年 AI 经验」的硬门槛只有 9%
            <Cite id="S27" />。关键词决定你会不会被搜到，证据决定你会不会被留下。
          </p>

          <h3>2026 的能力词</h3>
          <ul class="ig-list">
            <li><strong>上下文工程</strong>：指令、检索、工具返回、历史怎么放，预算怎么压；不是把 prompt 写长<Cite id="S31" />。</li>
            <li><strong>评测</strong>：任务、用例、评分、回归；每条跑多次看稳定性，失败要分类<Cite id="S32" />。</li>
            <li><strong>Agent 的工具与权限</strong>：工具选错、超时、越权怎么兜；写清人工接管率。</li>
            <li><strong>模型路由与单位经济</strong>：什么请求给贵模型，每次成功交付多少钱。</li>
            <li><strong>Responsible-AI 上线</strong>：上线闸门、事故归属、回滚方案<Cite id="S29" />。</li>
          </ul>
          <p class="ig-note">这些词不是背定义：面试官会要一条你亲手做过的证据。</p>

          <h3>对齐矩阵</h3>
          <p>
            把 JD 的每条要求抄进第一列，第二列放你的证据，第三列写缺口，第四列写补法或写在哪。
            填不满的格子，就是接下来两周要补的东西。
          </p>
          <div class="ig-table-wrap">
            <table class="ig-table ig-matrix">
              <caption>示例：一份 AI 产品经理 JD</caption>
              <thead>
                <tr><th>JD 要求</th><th>我的证据</th><th>缺口</th><th>补法 / 写在哪</th></tr>
              </thead>
              <tbody>
                <tr><td>3 年 AI / 内容 / 工具产品经验</td><td>2 年内容社区 + 1 年 AI 助手</td><td>AI 头衔只有 1 年</td><td>把 AI 项目前置，写清模型与评测<Cite id="S25" /></td></tr>
                <tr><td>理解模型能力边界</td><td>200 条评测集、3 类失败分类</td><td>缺成本口径</td><td>补单位成本与模型路由</td></tr>
                <tr><td>搭建评测体系</td><td>摘要采纳率 62% → 81%</td><td>缺回归集</td><td>加 30 条回归样本，写进项目页</td></tr>
                <tr><td>B 端交付</td><td>12 个部门、月均 3,000 单</td><td>缺客户验收</td><td>补验收标准与复用率</td></tr>
                <tr><td>写作与沟通</td><td>3 篇复盘文章</td><td>缺英文材料</td><td>先补一页英文摘要<Cite id="S24" /></td></tr>
              </tbody>
            </table>
          </div>

          <h3>级别与公司阶段</h3>
          <div class="ig-split">
            <div>
              <h4>级别看“证据的难度”</h4>
              <ul class="ig-list">
                {
                  LEVELS.map((level) => (
                    <li>
                      <strong>{level.title}</strong>：{level.signal}；证据是{level.proof}。
                    </li>
                  ))
                }
              </ul>
            </div>
            <div>
              <h4>阶段看“证据的类型”</h4>
              <ul class="ig-list">
                {
                  STAGES.map((stage) => (
                    <li>
                      <strong>{stage.title}</strong>：看重{stage.looks}；优先放{stage.evidence}。
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
          <p class="ig-note">
            级别名称（P6 / P7、L5 / L6）各家不同，公开材料里没有统一标准；
            用「管理半径、决策权、是否定义问题」对齐，比背级别表可靠。
          </p>

          <h3>定制与造假的三条红线</h3>
          <ol class="ig-list ig-list-number">
            <li><strong>时间线与职位不改</strong>：入职离职时间、title、汇报关系，背调一查就穿<Cite id="S17" />。</li>
            <li><strong>数字不改口径</strong>：可以换一种更清楚的表达，不能换分母、换时间窗、把团队结果写成个人结果。</li>
            <li><strong>角色不升格</strong>：参与就写参与，负责就写负责；把「参与」写成「主导」是追问链上最容易崩的一环。</li>
          </ol>

          <h3>缺口怎么办</h3>
          <ul class="ig-list">
            <li>只缺一个能力项：用 30 天补一条最小证据，评测表、复盘文章、可点开的原型，三选一；
              具体节奏见<a href={`${resumeHref}#s4`}>简历指南的 30 天证据包</a>。</li>
            <li>缺渠道：内推是换队列，不是免筛；它有独立入口与保护期<Cite id="S18" />，但简历仍要过评估。</li>
            <li>缺信心：35 岁门槛是部分行业的现象，不是普遍规则，报道里的个案不能当统计
              <Cite id="S28" />；把“年限”换成“可复用的方法 + 可验证的结果”，比解释年龄有效。</li>
          </ul>
          <p class="ig-note">
            另一条岔路是 FDE（前线部署工程师）：2026 年 4 月 Indeed 上的岗位数比 2025 年 1 月高 5,230%，
            薪资约 $170k–$200k+<Cite id="S33" />。它要驻客户现场、写生产代码，不是 PM 的升级版；
            想走这条路，简历要放交付与工程证据，而不是产品规划。
          </p>
          <p class="ig-callout">
            一岗一版，改的是排序与重点，不是事实。投十家同一份简历，不如投三家各改一版。
          </p>
        </section>

        <section class="ig-section" id="s6" data-ig-section>
          <p class="ig-kicker">06 · 表达</p>
          <h2>八个环节怎么答：每一轮只练一个动作</h2>
          <p class="ig-lead">
            这一节与站内模拟面试共用同一套环节。别一次练八件事：每一轮只盯一个动作，
            练到不看稿也能讲完。
          </p>

          <div class="ig-phases">
            {
              PHASES.map((phase, index) => (
                <article class="ig-phase">
                  <p class="ig-phase-no">{String(index + 1).padStart(2, '0')}</p>
                  <h3>{phase.label}</h3>
                  <dl>
                    <div><dt>在验证</dt><dd>{phase.verify}</dd></div>
                    <div><dt>结构</dt><dd>{phase.structure}</dd></div>
                    <div><dt>挂点</dt><dd>{phase.pitfall}</dd></div>
                    <div><dt>练法</dt><dd>{phase.practice}</dd></div>
                  </dl>
                </article>
              ))
            }
          </div>

          <h3>两个可以直接照着说的模板</h3>
          <div class="ig-templates">
            <div>
              <p class="ig-template-title">90 秒自我介绍</p>
              <p>
                「我是【姓名】，做【方向】第【N】年，现在在【公司】负责【一句话职责】。
                最近两年我做成过两件事：第一件是【结果 + 口径】，第二件是【结果 + 口径】。
                我来面这个岗，是因为【岗位要解决的问题】正好是我做过的那类问题；
                我想把【可复用的方法】带过来。」
              </p>
            </div>
            <div>
              <p class="ig-template-title">3 分钟项目故事</p>
              <p>
                「背景是【用户 / 业务 + 基线】，目标是把【指标】从【A】做到【B】。
                我当时负责【范围】，约束是【时间 / 人力 / 合规】。
                关键决策有两个：一是【选项 A vs B，为什么选 A】，二是【放弃什么，代价是什么】。
                结果是【结果 + 口径】，失败主要出在【失败类型】，我补了【兜底】。
                如果重来，我会【改哪一步】，因为【判断依据】。」
              </p>
            </div>
          </div>

          <h3>现场轮：带一个能当场打开的东西</h3>
          <p>
            如果面试让你当场改一版，或者讲一个自己做的原型，按 3 分钟决策链讲：
            问题与约束 → 我做的取舍 → 结果与口径 → 失败与兜底 → 如果重来<Cite id="S30" />。
            带的东西可以是可点原型、eval 样本或一个真实小项目；不要带一份模型二十分钟就能写出来的 PRD。
          </p>

          <p>
            AI 岗的一面常直接问模型选型、评测维度与上线后的北极星指标<Cite id="S23" />；
            这类题不要背答案，讲清你当时比较了哪几版、用什么样本、最后怎么取舍。
          </p>

          <h3>压力追问怎么接</h3>
          <p>
            国内面经里的压力面，通常不是刁难，而是连续加码：先问方案，再问为什么不是另一个，
            最后问“凭什么”。可对照的样本：
          </p>
          <ul class="ig-list">
            <li>「三个冷启动方案，你选哪个？从影响力还是获客效率看？」<Cite id="S20" /></li>
            <li>「北京一年签多少租赁合同？凭什么说 2,000 万人？」<Cite id="S20" /></li>
            <li>「还有呢？」连问三次，考的是你有没有第三层思考<Cite id="S22" /></li>
          </ul>
          <p>
            接法是固定的：停两秒，复述问题，先给结论，再给依据，最后明确哪部分你不知道。
            不知道不扣分，编数字才扣分。
          </p>

          <h3>反问：问业务，不问福利</h3>
          <ol class="ig-list ig-list-number">
            <li>这个岗位现在最痛的一件事是什么？</li>
            <li>六个月后，你用什么判断这个人做得好？</li>
            <li>这个岗位是扩编还是补位？上一任为什么离开？</li>
            <li>决策链是什么样的：谁拍板、谁能否决？</li>
            <li>团队现在怎么评测 AI 功能的好坏？</li>
          </ol>
          <p class="ig-note">
            英文面多一步：把「结果 + 口径」压成一句 20 秒的版本，先给数字再给背景；
            写作能力在海外 JD 里常被单列<Cite id="S24" />，准备一页英文项目摘要比背模板有用。
          </p>
          <p>
            想练一轮：<a href={interviewHref}>打开模拟面试</a>，按环节选「项目深挖」或「追问与压力」，
            练习模式会当场点评。
          </p>
        </section>

        <section class="ig-section" id="s7" data-ig-section>
          <p class="ig-kicker">07 · 复盘</p>
          <h2>面经怎么用：从背题到建库</h2>
          <p class="ig-lead">
            面经的价值不在题目，而在追问链和挂点。先把三种偏差记住，再把别人的题变成自己的证据卡。
          </p>

          <h3>三条经验</h3>
          <ul class="ig-list">
            <li><strong>追问比题目值钱</strong>：同一道题，不同公司追问的方向不同；记下追问，等于记下这个岗位真正怕什么。</li>
            <li><strong>同一段经历准备三个长度</strong>：30 秒给 HR，90 秒给一面，3 分钟给二面与总监；内容不变，只改详略。</li>
            <li><strong>面完当天写</strong>：超过 24 小时，细节会掉一半；先写被问住的那一句，再写题目。</li>
          </ul>

          <h3>三种偏差</h3>
          <ul class="ig-list">
            <li><strong>幸存者偏差</strong>：发帖的多是拿到 offer 的人，失败样本少，别把面经当通过率。</li>
            <li><strong>记忆偏差</strong>：事后回忆会补全逻辑，题目顺序与追问细节未必准确。</li>
            <li><strong>公司与年份差异</strong>：同一家公司不同业务线、不同年份，流程能差出一倍
              <Cite id="S20" /><Cite id="S22" />。</li>
          </ul>
          <p class="ig-callout">
            站内 716 条题库也有自己的偏差：字节 216 条约占三成，97 条标不出公司；
            题库那次采集里，知乎、Reddit、Glassdoor、Blind 都没抓到，海外样本很少。用它找题型，不要用它推比例。
          </p>

          <h3>一张卡片</h3>
          <div class="ig-table-wrap">
            <table class="ig-table">
              <thead>
                <tr><th>题目</th><th>考点</th><th>我的证据</th><th>90 秒答法</th><th>可能追问</th></tr>
              </thead>
              <tbody>
                <tr>
                  <td>为什么选这个模型？</td>
                  <td>选型与成本</td>
                  <td>三版对比、单次成本</td>
                  <td>候选 → 维度 → 实验 → 取舍</td>
                  <td>换便宜模型会掉多少？</td>
                </tr>
                <tr>
                  <td>怎么评测一个 RAG 产品？</td>
                  <td>评测设计</td>
                  <td>200 条评测集、3 类失败</td>
                  <td>任务 → 用例 → 评分 → 回归</td>
                  <td>评分标准谁定的？</td>
                </tr>
                <tr>
                  <td>上线后指标没涨怎么办？</td>
                  <td>归因</td>
                  <td>漏斗、灰度、对照组</td>
                  <td>先排除口径，再拆漏斗</td>
                  <td>你怎么知道不是季节因素？</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h3>复盘表</h3>
          <div class="ig-table-wrap">
            <table class="ig-table">
              <thead>
                <tr><th>场次</th><th>被问住的题</th><th>缺口类型</th><th>下一场改什么</th><th>截止</th></tr>
              </thead>
              <tbody>
                <tr><td>某公司一面</td><td>估算没有给分母</td><td>数据</td><td>补三个常用估算的拆解</td><td>周三</td></tr>
                <tr><td>某公司二面</td><td>失败案例讲成了外部原因</td><td>复盘</td><td>重写失败项目的责任边界</td><td>周四</td></tr>
                <tr><td>模拟面试</td><td>反问只问了团队氛围</td><td>动机</td><td>换成三个业务问题</td><td>当天</td></tr>
              </tbody>
            </table>
          </div>
          <p class="ig-note">
            每场只写三条：答得住的、答不住的、下一场怎么补。写多了不会执行。
          </p>

          <h3>失败诊断</h3>
          <div class="ig-table-wrap">
            <table class="ig-table">
              <thead>
                <tr><th>症状</th><th>先改哪里</th></tr>
              </thead>
              <tbody>
                <tr><td>投了很多没有回音</td><td>先改定位与前三行，再改渠道；不要先改模板</td></tr>
                <tr><td>一面就挂</td><td>项目故事：目标、约束、你的部分、结果口径</td></tr>
                <tr><td>二面就挂</td><td>取舍与判断：每个项目补一张决策点清单</td></tr>
                <tr><td>交叉面挂</td><td>一致性：简历、面试、前同事评价对不对得上</td></tr>
                <tr><td>HR 面挂</td><td>动机与稳定性：离职原因、城市、薪资预期要能自洽</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="ig-section" id="s8" data-ig-section>
          <p class="ig-kicker">08 · 方法</p>
          <h2>五步证据法：把上面所有事串成一条线</h2>
          <p class="ig-lead">
            简历写证据，面试讲决策，复盘改证据。五步走完一遍，你会得到一份能投的简历、
            八个能讲的环节，和一张知道下一步补什么的表。
          </p>

          <div class="ig-table-wrap">
            <table class="ig-table ig-steps">
              <thead>
                <tr><th>步</th><th>问题</th><th>输入</th><th>动作</th><th>产出</th><th>验收</th></tr>
              </thead>
              <tbody>
                {
                  STEPS.map((step) => (
                    <tr>
                      <td><strong>{step.no} {step.title}</strong></td>
                      <td>{step.ask}</td>
                      <td>{step.input}</td>
                      <td>{step.action}</td>
                      <td>{step.output}</td>
                      <td>{step.check}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <h3>7 天节奏</h3>
          <ol class="ig-plan">
            {
              PLAN.map((day) => (
                <li>
                  <span class="ig-plan-day">{day.day}</span>
                  <div>
                    <strong>{day.title}</strong>
                    <p>{day.task}</p>
                  </div>
                </li>
              ))
            }
          </ol>

          <h3>面试前 10 分钟清单</h3>
          <ul class="ig-checklist">
            {CHECKS.map((check) => <li>{check}</li>)}
          </ul>

          <h3>六条常见误区</h3>
          <div class="ig-table-wrap">
            <table class="ig-table">
              <thead>
                <tr><th>看起来对</th><th>换成什么</th></tr>
              </thead>
              <tbody>
                {
                  PITFALLS.map((item) => (
                    <tr>
                      <td>{item.bad}</td>
                      <td>{item.fix}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <h3>三条长期习惯</h3>
          <ul class="ig-list">
            <li>每做完一个项目，留一页复盘：目标、取舍、结果口径、失败分类。</li>
            <li>每个季度更新一次证据库：新数字、新作品、新的外部评价。</li>
            <li>每场面试后 24 小时内写三条修正，超过一天就只剩情绪。</li>
          </ul>
          <p class="ig-callout">
            方法不保证结果，但保证可迭代。你控制不了对方有没有 headcount，
            能控制的是下一场比上一场多一条能验证的证据。
          </p>
        </section>

        <section class="ig-section" id="s9" data-ig-section>
          <p class="ig-kicker">09 · 依据</p>
          <h2>来源与限制</h2>
          <p>
            共 {SOURCES.length} 条来源，按编号排列；正文用方括号角标引用。抓取日期 2026-10-28。
            外链失效时，用机构与标题检索原文。
          </p>
          <ol class="ig-sources">
            {
              SOURCES.map((source) => (
                <li id={`src-${source.id}`}>
                  <span class="ig-source-no">[{source.id.replace(/^S/, '')}]</span>
                  <span class="ig-source-org">{source.org}</span>
                  <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a>
                  <span class="ig-source-meta">{source.date} · {source.kind}</span>
                  <span class="ig-source-note">{source.note}</span>
                </li>
              ))
            }
          </ol>

          <h3>这份页面不能替你保证什么</h3>
          <ul class="ig-list">
            <li><strong>调查对象不是产品经理岗</strong>：简历时长与偏好数据来自各行业 HR 的自报调查<Cite id="S9" />，不是 PM 岗的通过率。</li>
            <li><strong>面经是候选人自述</strong>：轮次、时长、追问都来自发帖人回忆，年份与业务线差异很大<Cite id="S20" /><Cite id="S21" /><Cite id="S22" />。</li>
            <li>
              <strong>2026 新概念来源参差</strong>：AI-fluency 与现场轮来自社区整理与行业博客
              <Cite id="S29" /><Cite id="S30" />；上下文工程与评测是官方文章<Cite id="S31" /><Cite id="S32" />；
              FDE 数据来自媒体报道<Cite id="S33" />。
            </li>
            <li><strong>海外流程多为二手汇总</strong>：官方只确认结构化与大致轮次；具体维度名、AI 轮时长各来源不一<Cite id="S4" /><Cite id="S5" />。</li>
            <li><strong>秒数是量级，不是承诺</strong>：7.4 秒、30 秒、17–46 秒是三套口径，样本与方法都不同<Cite id="S10" /><Cite id="S14" />。</li>
            <li><strong>示例数字是演示</strong>：三组 Before / After 与对齐矩阵里的数字，只用来解释写法，不是任何人的真实成绩。</li>
            <li><strong>个案不是规律</strong>：35 岁门槛的报道是个案<Cite id="S28" />；婚育不该被问，有明确政策依据<Cite id="S19" />。</li>
          </ul>
          <p class="ig-note">
            如果只能记住一句话：面试是验证，简历是假设，方法是把每一次验证的结果写回假设。
          </p>
        </section>

