# 复制为 .env 后填写（.env 不入库）
# 模型接口：任何兼容 OpenAI 的地址（本机服务、云厂商或中转）
LAB_LLM_BASE_URL=http://127.0.0.1:8080/v1
LAB_LLM_API_KEY=
LAB_MODEL=big-pickle
# 可选：没有模型档案时的输出上限；选了档案就用档案里的 max_output_tokens
# LAB_MAX_OUTPUT_TOKENS=4096

# 可选：路径默认按仓库位置推断
# LAB_BOOK_DIR=../book
# LAB_PERSONAL_DIR=../personal
# LAB_DATA_DIR=../personal/lab

# 阅读器地址：确认写入补充时调用它的 /__personal API
LAB_READER_URL=http://127.0.0.1:4321

# 可选：联网工具代理。默认使用系统代理，连接失败会自动直连；off 强制直连。
# LAB_WEB_PROXY=http://127.0.0.1:7890

# 可选：模型价格目录（models.dev 的公开 JSON），缓存写在 personal/lab/pricing/
# LAB_PRICING_URL=https://models.dev/api.json
# LAB_PRICING_TTL_H=24

# MCP 知识服务（需求 024 / 036）：外部应用经阅读器 /__lab/mcp 访问。
# token 由 personal/deploy/deploy-local.sh 首次部署时生成、之后保留；少于 16 位时端点关闭（503）。
# 手工改值后要重启实验台；轮换用 --action rotate-token。
# LAB_MCP_TOKEN=
# ask_book 默认等待秒数与最大轮数
# LAB_MCP_ASK_WAIT_S=45
# LAB_MCP_ASK_MAX_TURNS=8
# 同时运行的问答上限、每分钟启动上限、旧式会话内存 TTL
# LAB_MCP_MAX_ACTIVE_ASKS=2
# LAB_MCP_ASKS_PER_MINUTE=12
# LAB_MCP_SESSION_TTL_S=3600
