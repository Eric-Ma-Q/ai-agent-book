# 复制为仓库根的 .env；scripts/start.sh 会读取，已有环境变量优先。
# 这个文件只放端口与更新配置，模型密钥仍写在 agent-lab/.env。

# 端口
READER_PORT=4321
LAB_PORT=4330

# 更新中心（需求 031）。已指向发布仓库；fork 到别处时改成自己的 owner/repo。
UPDATE_REPO=Eric-Ma-Q/ai-agent-book
UPDATE_BRANCH=main

# 可选：自定义重启命令，默认在 macOS 上尝试 launchctl kickstart。
# UPDATE_RESTART_CMD='launchctl kickstart -k gui/501/com.example.reader'

# 可选：管理员 token 也可以写在环境变量里；推荐放文件：
#   mkdir -p personal/update && openssl rand -hex 24 > personal/update/token && chmod 600 personal/update/token
# UPDATE_ADMIN_TOKEN=
